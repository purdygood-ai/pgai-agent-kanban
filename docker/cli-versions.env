# docker/cli-versions.env
#
# Single source of the pinned provider-CLI versions every docker/<flavor>/
# Dockerfile installs. A Dockerfile must never hardcode a CLI version of
# its own -- it takes the version in through a build ARG sourced from this
# file (read via team/tests/fixtures/docker_cli_pins.py, which turns these
# key/value pairs into --build-arg flags for the container-engine build
# invocation). See docs/docker.md for the version-bump ritual: how a
# candidate version is carried through the cold-build lane before landing
# here as an ordinary RC.
#
# One KEY=value per line. No comments or blank lines between entries.
CLAUDE_CODE_VERSION=2.1.296
CODEX_VERSION=0.162.1
