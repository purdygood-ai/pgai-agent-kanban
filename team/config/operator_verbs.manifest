V	verify-rc-state	active	scripts/verify-rc-state.sh	help|verbose	no	read-only	GET	/verify-rc-state	NONE	read	ShellEnvelope	module:pgai_agent_kanban.ops.rc_state.verify_rc_state
V	reset	active	scripts/reset.sh	project|key|keep-artifacts|force|help	yes	idempotent	POST	/operations/reset	ResetBody	action	DualChannelShellEnvelope	module:pgai_agent_kanban.ops.write.reset_item
V	close	active	scripts/close.sh	project|key|state|note|dry-run|help	yes	idempotent	POST	/operations/close	CloseBody	action	DualChannelShellEnvelope	module:pgai_agent_kanban.ops.write.close_item
