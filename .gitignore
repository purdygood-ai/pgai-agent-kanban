# Personal configuration — should never be committed
# shell-env (non-secret settings) and secrets (sensitive credentials)
shell-env
secrets
# claude-env (Claude CLI runtime tuning). See claude-env_example.
claude-env
# Real kanban and project configuration; the *_example files are the templates
kanban.cfg
project.cfg
projects.cfg
pseudocron.cfg
pseudocron.env
# Private keys and certificates
*.pem
*.key
# Older environment file names, still ignored if present from old installs
bashrc
env
.env
.env.local
# Older runtime provider-state file; the active provider is kanban.cfg [providers] active
active-provider

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Coverage
team/.coverage
team/coverage-baseline.txt

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime data — these are created at install time in the kanban root,
# not in the repo. But just in case someone runs the wake scripts from
# inside the repo directory, keep them out of version control.
tasks/queues/logs/
tasks/queues/locks/
tasks/queues/plans/
tasks/CLAUDE-*/
tasks/HUMAN-*/
# Multi-queue runtime artifacts (team/ layout)
team/tasks/queues/claude/logs/
team/tasks/queues/claude/locks/
# API server durable state (pidfile lives here; runtime output, not source)
team/run/

# Temp
/tmp/
*.tmp
*.bak

# Runtime task data - belongs in live install, not dev tree
tasks/
projects/

# Generated agent output and published deliverables - must not be committed.
# Task artifacts (CODER/TESTER/etc.) and document-workflow publishes are
# runtime output, not source. They belong in the live install under
# projects/<name>/artifacts/, never in the dev tree.
artifacts/
tester-reports/

# Exception: team/tests/artifacts/ holds hand-written archived snapshots
# (reports, notes, the scripts that produced them) and IS tracked in version
# control. Generated files there -- logs, coverage JSON -- are still ignored
# by the generated-files block below.
!team/tests/artifacts/

# Generated files: logs, locks, coverage output, merge leftovers, rotated
# task artifacts, and the kanban runtime directories at the tree root. Kept
# last so they also apply inside the re-included directories above.
# team/scripts/lint_tracked_ignored.py reports any tracked file an ignore
# rule matches, and any tracked file of these generated kinds.
*.log
*.lock
.coverage
.coverage.*
coverage*.json
*-coverage.json
htmlcov/
*.orig
nohup.out
*.previous-RUN-*
/logs/
/locks/
/run/
