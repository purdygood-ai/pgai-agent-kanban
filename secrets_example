# secrets_example — sensitive credentials sourced before each wake firing.
#
# Copy to "secrets" in the kanban root and edit:
#
#   cp secrets_example "$PGAI_AGENT_KANBAN_ROOT_PATH/secrets"
#   chmod 600 "$PGAI_AGENT_KANBAN_ROOT_PATH/secrets"
#
# Put OAuth tokens, API keys, and any other sensitive credentials here.
# Anything that should NOT be committed to git or logged in plaintext
# belongs in this file — and credentials belong in no other template.
#
# Who sources it: the wake path only (team/scripts/lib/wake_bootstrap.sh,
# on every wake firing, after shell-env). No other entry point sources it:
# po-agent.sh and `project-summary --llm` never see these variables, so a
# credential they need must come from the CLI's own login (claude login,
# codex login) or the environment that launches them.
#
# Security notes:
#   - The live "secrets" file is gitignored. Never commit it.
#   - The file is shell-sourced — any syntax error halts the wake firing.
#     Test edits with: bash -n $PGAI_AGENT_KANBAN_ROOT_PATH/secrets
#   - Mode should be 0600 (operator-readable only). The install hint above
#     sets this; preserve it if you back up or copy the file.
#   - This file is OPTIONAL — wake scripts work without it as long as
#     credentials are available through some other mechanism (e.g. the
#     credentials file written by `claude login`).
#
# Authentication mode (AI_AUTH_MODE):
#   The wake bootstrap reads ai_auth_mode from kanban.cfg [providers]
#   (default oauth) and exports AI_AUTH_MODE before sourcing this file. The
#   if/else block below branches on that value so you only configure
#   credentials for the mode you use.
#   Only the exact string "apikey" selects API-key mode; any other value
#   (oauth, OAuth, api-key, a typo) acts as oauth.
#   Default: oauth.
#
#   oauth  (default): Claude Code OAuth flow. Unsets API-key variables so they
#          cannot accidentally override the OAuth token in downstream tools.
#          No entries in this file are required — `claude login` credentials
#          are used automatically by the Claude CLI.
#
#   apikey: Traditional API key flow. Uncomment the ANTHROPIC_API_KEY export
#          and set your key. OAuth variables are left as-is.
#
# All lines below are commented out by default. Uncomment to use.


# --- Auth-mode credential block ---
# This block branches on AI_AUTH_MODE (set by the wake bootstrap from
# kanban.cfg [providers] ai_auth_mode).
if [[ "${AI_AUTH_MODE:-oauth}" == "apikey" ]]; then
    # ANTHROPIC_API_KEY — the Anthropic API key the Claude CLI bills
    # against. Needed only when ai_auth_mode=apikey.
    # Default: unset (the CLI uses the `claude login` credentials).
    # NEVER commit a real key — replace the placeholder with your actual key
    # in your live secrets file (which is gitignored).
    # export ANTHROPIC_API_KEY="sk-ant-YOUR-KEY-HERE"
    #
    # OPENAI_API_KEY — an OpenAI API key, for tools that read one. The codex
    # CLI does NOT authenticate from it: it reads ~/.codex/auth.json, which
    # `codex login` writes (API-key or ChatGPT sign-in). Switching codex
    # between the two needs `codex logout` then `codex login`, not this
    # variable. Needed only by a tool of your own that reads it.
    # Default: unset.
    # export OPENAI_API_KEY="sk-YOUR-KEY-HERE"
    :
else
    # oauth mode (default): unset API-key variables so they cannot
    # accidentally override OAuth credentials in downstream tools.
    unset ANTHROPIC_API_KEY
    # codex does not authenticate from OPENAI_API_KEY (it reads
    # ~/.codex/auth.json); it is unset for the same reason as above.
    unset OPENAI_API_KEY
    # CLAUDE_CODE_OAUTH_TOKEN — a long-lived Claude Code OAuth token, made
    # with `claude setup-token`. Needed only where the CLI cannot use the
    # `claude login` credentials stored for this account (a container or a
    # host without them).
    # Default: unset (the CLI uses the `claude login` credentials).
    # export CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-YOUR-TOKEN-HERE"
    :
fi


